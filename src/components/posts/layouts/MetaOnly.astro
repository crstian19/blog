---
import { formatDate } from '~/lib/utils'
import { ANALYTICS_CONFIG, POSTS_CONFIG } from '~/config'
import Prose from '~/components/posts/base/Prose.astro'
import Badge from '~/components/posts/base/Badge.astro'
import { getLocale, useTranslations } from '~/i18n'

const lang = getLocale(Astro.url)
const t = useTranslations(lang)

interface Props {
  frontmatter: any
  minutesRead?: string
  wordCount?: number
}

const { frontmatter, minutesRead, wordCount } = Astro.props
const recommendText = t('posts.recommend')
---

<article class="relative fade-up">
  <div class="px-6 sm:px-8 py-4 sm:py-6 lg:py-8">
    <div class="global-layout-width mx-auto">
      <header>
        <div class="space-y-4 md:space-y-5">
          {frontmatter.description && <p class="text-sm text-muted-foreground/90 leading-relaxed">{frontmatter.description}</p>}

          <div class="text-xl lg:text-2xl font-semibold leading-tight" data-pagefind-body data-pagefind-meta="title">
            {frontmatter.title}
          </div>

          <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-sm text-muted-foreground/85">
            <div class="flex items-center gap-1.5">
              <span class="icon-[ph--calendar-blank] w-4 h-4 opacity-85"></span>
              <time datetime={frontmatter.pubDate.toISOString()}>{formatDate(frontmatter.pubDate, 'default', lang)}</time>
              {frontmatter.updatedDate && (
                <div class="flex items-center gap-1.5">
                  / {t('posts.updated')}
                  <time datetime={frontmatter.updatedDate.toISOString()}>{formatDate(frontmatter.updatedDate, 'default', lang)}</time>
                </div>
              )}
            </div>

            {minutesRead && (
              <div class="flex items-center gap-1.5">
                <span class="icon-[ph--book-open-text] w-4 h-4 opacity-85" />
                <span>
                  {minutesRead} {t('posts.minutes')}
                </span>
              </div>
            )}
            {POSTS_CONFIG.wordCountView && wordCount && (
              <div class="flex items-center gap-1.5">
                <span class="icon-[ph--pencil-simple-line] w-4 h-4 opacity-85" />
                <span>
                  {wordCount} {t('posts.words')}
                </span>
              </div>
            )}
            {ANALYTICS_CONFIG.vercount?.enabled && (
              <div class="flex items-center gap-1.5">
                <span class="icon-[ph--eye] w-4 h-4 opacity-85" />
                <span id="vercount_value_page_pv">…</span> {t('posts.views')}
              </div>
            )}
          </div>

          <div class="flex gap-2 sm:gap-2.5 lg:gap-3 flex-wrap">
            {frontmatter.recommend && <Badge type="recommend" content={recommendText} />}
            {frontmatter.tags?.map((tag: string) => (
              <Badge type="tag" content={tag} size="sm" />
            ))}
          </div>
        </div>
        <div class="border-b border-border/60 my-8 sm:my-10 lg:my-12"></div>
      </header>

      <Prose>
        <slot />
      </Prose>
    </div>
  </div>
</article>
