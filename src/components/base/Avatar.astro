---
import { Image } from 'astro:assets'
import { SITE } from '~/config'
import { cn } from '~/lib/utils'
import base from '~/assets/avatar/base.png'

interface Props {
  /** Rendered height in CSS pixels; the width follows the drawing's aspect ratio. */
  height: number
  class?: string
}

const { height, class: className } = Astro.props
const width = Math.round((height * base.width) / base.height)

// The eyes are drawn as vectors so they stay crisp at any size. Each one is a
// pill measured on the original drawing, in the coordinates of base.png at
// full size (945x1109): centre, length, width and tilt in degrees.
const VIEWBOX = { width: 945, height: 1109 }
const EYE_COLOR = '#19181b'
const eyes = [
  { cx: 310.8, cy: 488.2, length: 178, width: 80, rotate: 20.6 },
  { cx: 657, cy: 615.4, length: 180, width: 80, rotate: 20.9 },
]
---

<span class={cn('relative inline-block select-none', className)} style={`width:${width}px;height:${height}px`} data-avatar>
  <Image src={base} {width} {height} alt={SITE.author} class="size-full" densities={[1, 2, 3]} loading="eager" />
  <svg viewBox={`0 0 ${VIEWBOX.width} ${VIEWBOX.height}`} class="absolute inset-0 size-full overflow-visible" aria-hidden="true">
    {eyes.map((eye) => (
      <g data-avatar-eye class="transition-transform duration-150 ease-out">
        <rect
          x={eye.cx - eye.width / 2}
          y={eye.cy - eye.length / 2}
          width={eye.width}
          height={eye.length}
          rx={eye.width / 2}
          fill={EYE_COLOR}
          transform={`rotate(${eye.rotate} ${eye.cx} ${eye.cy})`}
        />
      </g>
    ))}
  </svg>
</span>

<script>
  // The eyes look at the pointer: each one shifts towards it by up to MAX_SHIFT
  // (in the drawing's units, about a third of an eye's width), reaching the full
  // shift once the pointer is FULL_AT screen pixels away.
  const MAX_SHIFT = 28
  const FULL_AT = 240

  let pointer: { x: number; y: number } | null = null
  let frame = 0

  function update() {
    frame = 0
    if (!pointer) return
    for (const eye of document.querySelectorAll<SVGGElement>('[data-avatar-eye]')) {
      const rect = eye.getBoundingClientRect()
      const dx = pointer.x - (rect.left + rect.width / 2)
      const dy = pointer.y - (rect.top + rect.height / 2)
      const distance = Math.hypot(dx, dy) || 1
      const reach = Math.min(distance / FULL_AT, 1) * MAX_SHIFT
      // Inside the SVG, px in a CSS transform are user units of the viewBox.
      eye.style.transform = `translate(${(dx / distance) * reach}px, ${(dy / distance) * reach}px)`
    }
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.addEventListener(
      'pointermove',
      (event) => {
        pointer = { x: event.clientX, y: event.clientY }
        if (!frame) frame = requestAnimationFrame(update)
      },
      { passive: true }
    )
    // New pages from the client router bring fresh eyes; point them at the cursor too.
    document.addEventListener('astro:page-load', () => {
      if (!frame) frame = requestAnimationFrame(update)
    })
  }
</script>
