---
import { ClientRouter } from 'astro:transitions'
import { Font } from 'astro:assets'
import { ANALYTICS_CONFIG, SITE } from '~/config'
import { DEFAULT_LOCALE, LOCALE_TAGS, getLocale, localizePath, type Locale } from '~/i18n'

const lang = getLocale(Astro.url)

type Props = {
  title: string
  description: string
  image?: string
  alternates: Partial<Record<Locale, string>>
  article?: { publishedTime: Date; modifiedTime?: Date; tags?: string[] }
}

const { title, description, image, alternates, article }: Props = Astro.props
const hreflangs = Object.entries(alternates) as [Locale, string][]

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(image || SITE.ogImage, Astro.url)
---

<!-- 传递主题动画配置到全局 -->
<script is:inline define:vars={{ themeAnimation: SITE.themeAnimation }}>
  window.__themeAnimation = themeAnimation
</script>
<script is:inline src="/js/theme.js"></script>

<!-- 页面内SEO  On-Page SEO -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="google" content="notranslate" />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />

<!-- color -->
<meta name="theme-color" content="" />
<meta name="color-scheme" content="light dark" />

<!-- icon -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

{/* RSS Feed Link */}
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL(localizePath(lang, '/index.xml'), Astro.site).href} />

<!-- Translations of this page -->
{hreflangs.length > 1 &&
  hreflangs.map(([locale, href]) => <link rel="alternate" hreflang={locale} href={new URL(href, Astro.site).href} />)}
{hreflangs.length > 1 && alternates[DEFAULT_LOCALE] && (
  <link rel="alternate" hreflang="x-default" href={new URL(alternates[DEFAULT_LOCALE], Astro.site).href} />
)}

<link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

<!-- Fonts: only the body face is preloaded (it renders the LCP text); headings and code load on use -->
<Font cssVariable="--font-geist" preload />
<Font cssVariable="--font-lexend-face" />
<Font cssVariable="--font-geist-mono-face" />

<!-- 标准链接  Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph & Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
{article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
<meta property="og:locale" content={LOCALE_TAGS[lang].replace('-', '_')} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

{ANALYTICS_CONFIG.umami?.enabled && (
  <script
    is:inline
    defer
    src={ANALYTICS_CONFIG.umami.serverUrl}
    data-website-id={ANALYTICS_CONFIG.umami.websiteId}
    data-domains={ANALYTICS_CONFIG.umami.domains}
  ></script>
)}
{ANALYTICS_CONFIG.rybbit?.enabled && (
  <script is:inline defer src={ANALYTICS_CONFIG.rybbit.serverUrl} data-site-id={ANALYTICS_CONFIG.rybbit.siteId}></script>
)}
{ANALYTICS_CONFIG.vercount?.enabled && <script is:inline defer src="https://events.vercount.one/js" data-astro-rerun></script>}
{ANALYTICS_CONFIG.google?.enabled && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS_CONFIG.google.id}`}></script>
    <script is:inline define:vars={{ id: ANALYTICS_CONFIG.google.id }}>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', id)
    </script>
  </>
)}

<ClientRouter fallback="swap" />
