---
import { cn } from '~/lib/utils'
---

<div class={cn('fixed inset-0 mx-0 max-w-none hidden overflow-hidden md:block pointer-events-none dark:opacity-100')}>
  <div class="absolute left-1/2 top-[-14.5px] ml-[-41.5rem] h-[25rem] w-[80rem]">
    <!-- Purple glow, in the brand colors of crstian.me -->
    <div class="absolute inset-0 z-[2] bg-gradient-to-r from-brand/25 via-brand-3/10 to-brand/25 opacity-50 [mask-image:radial-gradient(farthest-side_at_top,white,transparent)] dark:from-brand/35 dark:via-brand-3/15 dark:to-brand/30 dark:opacity-100"></div>

    <!-- Background shape -->
    <svg
      viewBox="0 0 1113 440"
      aria-hidden="true"
      class="absolute left-1/2 top-0 z-0 ml-[-19rem] w-[69.5625rem] fill-background blur-[26px]"
    >
      <path d="M.016 439.5s-9.5-300 434-300S882.516 20 882.516 20V0h230.004v439.5H.016Z"></path>
    </svg>
  </div>
</div>
