---
import { cn } from '~/lib/utils'
import Layout from '~/layouts/Layout.astro'
import SectionDivider from '~/components/base/SectionDivider.astro'
import NumberTicker from '~/components/base/NumberTicker'
import { Image } from 'astro:assets'
import { getAllProjects } from '~/lib/data'
import { fetchGhcrPulls } from '~/lib/ghcr'
import PageTitle from '~/components/base/PageTitle.astro'
import { LOCALE_TAGS, getLocale, useTranslations } from '~/i18n'

const lang = getLocale(Astro.url)
const t = useTranslations(lang)
const title = t('projects.title')
const description = t('projects.description')
const introduce = t('projects.introduce')
// Container pulls are read at build time; the frontmatter count is the fallback.
const projects = await Promise.all(
  (await getAllProjects()).map(async (project) => {
    const live = project.data.dockerImage ? await fetchGhcrPulls(project.data.dockerImage) : undefined
    return { ...project, pulls: live ?? project.data.pulls }
  })
)
---

<Layout {title} {description}>
  <div class="relative z-[1] py-8 pb-10">
    <div class="px-6 sm:px-8">
      <PageTitle {title} {introduce} />
    </div>
    <div class="grid grid-cols-1 fade-up">
      {projects.map((project, index) => {
        let githubRepo = undefined
        if (project.data.githubUrl) {
          try {
            const urlObj = new URL(project.data.githubUrl)
            if (urlObj.hostname.includes('github.com')) {
              githubRepo = urlObj.pathname.replace(/^\/|\/$/g, '')
            }
          } catch (e) {}
        }

        return (
          <div>
            <div class="group relative hover:bg-muted/30 dark:hover:bg-muted/30 transition-colors duration-300 px-6 sm:px-8 py-4">
              <div class="absolute right-8 top-4 hidden sm:block">
                {project.data.logo ? (
                  <Image src={project.data.logo} alt="" width={48} height={48} class="project-logo size-12 object-contain" loading="lazy" />
                ) : (
                  project.data.type == 'icon' &&
                  project.data.iconClass && <span class={cn('size-10 text-muted-foreground', project.data.iconClass)} />
                )}
                {!project.data.logo && project.data.type == 'image' && project.data?.icon && (
                  <Image
                    src={project.data?.icon}
                    alt="icon"
                    width={40}
                    height={40}
                    class={cn(project.data.imageClass)}
                    densities={[1, 2]}
                    loading="lazy"
                  />
                )}
              </div>
              <a
                href={project.data.website ?? project.data.githubUrl}
                target="_blank"
                class="inline-flex items-center justify-between font-semibold text-lg/relaxed"
              >
                {project.data.name}
              </a>
              <p class="pr-0 sm:pr-14 text-muted-foreground mb-3">{project.data.description[lang]}</p>
              <div class="flex flex-col sm:flex-row gap-4 sm:gap-0 items-start sm:items-center justify-between sm:h-14">
                <div class="flex gap-4">
                  <div class="flex items-center py-1.5 gap-3">
                    {project.data.star != null && (
                      <>
                        <span class="text-xs uppercase tracking-wide font-medium text-muted-foreground">{t('projects.stars')}</span>
                        <span class="font-semibold text-lg tracking-wider">
                          <NumberTicker
                            play
                            value={project.data.star}
                            client:load
                            {githubRepo}
                            githubType="stars"
                            locale={LOCALE_TAGS[lang]}
                          />
                        </span>
                      </>
                    )}
                  </div>
                  <div class="flex items-center py-1.5 gap-3">
                    {project.data.fork != null && (
                      <>
                        <span class="text-xs uppercase tracking-wide font-medium text-muted-foreground">{t('projects.forks')}</span>
                        <span class="font-semibold text-lg tracking-wider">
                          <NumberTicker
                            play
                            value={project.data.fork}
                            client:load
                            {githubRepo}
                            githubType="forks"
                            locale={LOCALE_TAGS[lang]}
                          />
                        </span>
                      </>
                    )}
                  </div>
                  {project.pulls !== undefined && (
                    <div class="flex items-center py-1.5 gap-3">
                      <span class="text-xs uppercase tracking-wide font-medium text-muted-foreground">{t('projects.pulls')}</span>
                      <span class="font-semibold text-lg tracking-wider">
                        <NumberTicker play value={project.pulls} client:load locale={LOCALE_TAGS[lang]} />
                      </span>
                    </div>
                  )}
                </div>
                <div class="flex items-center gap-5 text-muted-foreground text-sm z-10">
                  {project.data.website && (
                    <a href={project.data.website} target="_blank" class="hover:text-primary flex items-center gap-1">
                      <span class="icon-[mdi--web] size-4" />
                      <span>{t('projects.website')}</span>
                    </a>
                  )}
                  {project.data.githubUrl && (
                    <a href={project.data.githubUrl} target="_blank" class="hover:text-primary flex items-center gap-1">
                      <span class="icon-[mdi--github] size-4" />
                      <span>GitHub</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
            <SectionDivider className={index == projects.length - 1 ? 'hidden' : ''} />
          </div>
        )
      })}
    </div>
  </div>
</Layout>
