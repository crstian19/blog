---
import { SKILLSSHOWCASE_CONFIG, SOCIAL_LINKS, GITHUB_CONFIG, POSTS_CONFIG } from '~/config'
import { getLocale, useTranslations } from '~/i18n'
import Layout from '~/layouts/Layout.astro'
import SectionDivider from '~/components/base/SectionDivider.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import SocialLink from '~/components/base/SocialLink.astro'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import { getNumPosts, getPinnedPosts } from '~/lib/data'

const lang = getLocale(Astro.url)
const t = useTranslations(lang)

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG

const pinnedPosts = await getPinnedPosts(lang)
const hasPinnedPosts = pinnedPosts.length > 0
const showPosts = hasPinnedPosts ? pinnedPosts : await getNumPosts(lang, size)
---

<Layout title={t('home.title')} description={t('site.description')}>
  <slot name="head" slot="head" />
  <div class="relative z-[1]">
    <div class="py-8 pb-10 px-6 sm:px-8">
      <h1 class="flex flex-col gap-2">
        <span class="text-4xl sm:text-5xl tracking-tight gradient-text w-fit">$ whoami</span>
        <span class="text-muted-foreground font-light text-xl sm:text-2xl block tracking-wide text-balance">
          {lang === 'es' ? 'Cristian, Site Reliability Engineer' : 'Cristian, Site Reliability Engineer from Spain'}
        </span>
      </h1>
      <div class="pro text-muted-foreground text-pretty">
        {lang === 'es' ? (
          <p>
            Uso Arch Linux en el PC y el portátil, y NixOS en los servidores. Me gusta estar aprendiendo siempre, así que aquí escribo de
            temas muy distintos: frontend, backend, DevOps, sysadmin…
          </p>
        ) : (
          <p>
            I use Arch Linux on my PC and laptop, and NixOS on my servers. I like to keep learning, so I write here about very different
            topics: frontend, backend, DevOps, sysadmin…
          </p>
        )}
      </div>
      <div class="mt-6 flex gap-6">
        {SOCIAL_LINKS.map((item) => (
          <SocialLink href={item.url} icon={item.icon} aria-label={item.name} count={item.count} label={t('home.followers')} />
        ))}
      </div>
    </div>
    {ENABLED && (
      <>
        <SectionDivider />
        <div class="py-8 pb-10 px-6 max-md:px-6">
          <div class="px-2 max-md:px-0">
            <h2 class="text-2xl sm:text-3xl">GitHub</h2>
            <p class="text-muted-foreground mb-6 mt-1">{t('home.contributions')}</p>
          </div>
          <GithubContributions
            username={GITHUB_USERNAME}
            tooltipEnabled={TOOLTIP_ENABLED}
            locale={lang}
            client:load
            transition:animate="none"
          />
        </div>
      </>
    )}
    {SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
      <>
        <SectionDivider />
        <div class="py-8 pb-10 px-6 max-md:px-6">
          <div class="px-2 max-md:px-0">
            <h2 class="text-2xl sm:text-3xl tracking-tight">{t('home.skills')}</h2>
            <p class="text-muted-foreground mb-6 mt-1">{t('home.skillsSub')}</p>
          </div>
          <SkillsShowcase skillsData={SKILLS_DATA} />
        </div>
      </>
    )}
    <SectionDivider />
    <div class="py-8 pb-10 px-6 sm:px-8">
      <h2 class="text-2xl sm:text-3xl tracking-tight">{t('home.posts')}</h2>
      <p class="text-muted-foreground mb-6 mt-1">
        {hasPinnedPosts ? t('home.pinned') : t('home.recent')}
        {showPosts.length}
        {t('home.postsSuffix')}
      </p>
      <List posts={showPosts} {type} coverLayout={POSTS_CONFIG.homePageConfig?.coverLayout} />
    </div>
  </div>
</Layout>
