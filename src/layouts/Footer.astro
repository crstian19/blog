---
import { FOOTER_LINKS, SITE } from '~/config'
import SectionDivider from '~/components/base/SectionDivider.astro'
import ThemeToggle from '~/components/theme/ThemeToggle'
import FooterLink from '~/components/base/FooterLink.astro'
import { getLocale, localizePath, useTranslations } from '~/i18n'

const lang = getLocale(Astro.url)
const t = useTranslations(lang)

const START_YEAR = 2019
const currentYear = new Date().getFullYear()
const yearDisplay = currentYear > START_YEAR ? `${START_YEAR}–${currentYear}` : `${START_YEAR}`
---

<SectionDivider className="border-t-border dark:border-t-border/50" />
<footer>
  <div class="py-4 flex-none border-x border-border/50 global-layout-width mx-auto">
    <div class="pb-8">
      <div class="flex flex-wrap gap-x-3 sm:gap-x-6 gap-y-1 text-sm font-medium text-muted-foreground pb-4 px-6 sm:px-8 border-b border-border/50">
        {FOOTER_LINKS.map((link) => (
          <FooterLink href={localizePath(lang, link.url)}>{t(link.key)}</FooterLink>
        ))}
        {/* Spelled out here because the header only shows the icon, and the footer is where
            people who use a feed reader look for it. */}
        <FooterLink href={localizePath(lang, '/index.xml')} class="inline-flex items-center gap-1">
          <span class="icon-[material-symbols--rss-feed] size-4"></span>{t('nav.rss')}
        </FooterLink>
      </div>
      <div class="text-sm text-muted-foreground px-6 sm:px-8 py-4">
        <div class="items-center flex flex-wrap gap-4 font-medium">
          <div class="flex flex-wrap items-center gap-x-1.5">
            <span>© {yearDisplay}</span>
            <span aria-hidden="true">·</span>
            <span>
              {t('footer.madeWith')}{' '}
              <a href="https://crstian.me" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
                {SITE.author}
              </a>{' '}
              {`${t('footer.from')} Murcia`}
            </span>
            <span class="inline-flex gap-[3px] ml-0.5">
              <svg class="footer-flag" viewBox="0 0 30 20" role="img" aria-label={t('footer.flagMurcia')}>
                <rect width="30" height="20" fill="#B4132E" />
                <g fill="#F9C623">
                  <rect x="3" y="3" width="3.4" height="3" />
                  <rect x="8" y="3" width="3.4" height="3" />
                  <rect x="3" y="8" width="3.4" height="3" />
                  <rect x="8" y="8" width="3.4" height="3" />
                  <circle cx="16" cy="12.5" r="1.1" />
                  <circle cx="20" cy="12.5" r="1.1" />
                  <circle cx="24" cy="12.5" r="1.1" />
                  <circle cx="28" cy="12.5" r="1.1" />
                  <circle cx="18" cy="16" r="1.1" />
                  <circle cx="22" cy="16" r="1.1" />
                  <circle cx="26" cy="16" r="1.1" />
                </g>
              </svg>
              <svg class="footer-flag" viewBox="0 0 30 20" role="img" aria-label={t('footer.flagSpain')}>
                <rect width="30" height="20" fill="#AA151B" />
                <rect y="5" width="30" height="10" fill="#F1BF00" />
              </svg>
            </span>
          </div>
          <div class="grow"></div>
          <div class="flex gap-2 items-center" transition:persist="footer-theme-toggle">
            <a
              href="https://github.com/crstian19/blog"
              target="_blank"
              class="inline-flex items-center justify-center hover:scale-105"
              aria-label={t('footer.source')}
              title={t('footer.source')}
            >
              <span class="icon-[mdi--github] size-5"></span>
            </a>
            <ThemeToggle client:load />
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Same flags as the tesdash footer */
  .footer-flag {
    height: 0.92em;
    width: auto;
    border-radius: 2px;
    box-shadow: 0 0 0 1px oklch(var(--foreground) / 0.12);
  }
</style>
